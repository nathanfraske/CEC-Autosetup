# SPDX-License-Identifier: Apache-2.0
# CEC-Autosetup driver-library refresh (oneshot). Regenerates the catalog mapping
# and re-pulls current + last-gen drivers into the served library. Paired with
# cec-driver-library-build.timer. See docs/driver-library.md.

[Unit]
Description=CEC-Autosetup driver library refresh (mapping + current/last-gen pull)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cec
Group=cec
Environment=CEC_HOME=/opt/cec-autosetup
Environment=CEC_LIBRARY=/srv/cec-drivers
# Refresh the ASUS + Gigabyte catalog rows, then pull current + last-gen drivers.
ExecStart=/usr/bin/pwsh -NoProfile -File ${CEC_HOME}/tools/Build-AsusMapping.ps1
ExecStart=/usr/bin/pwsh -NoProfile -File ${CEC_HOME}/tools/Build-GigabyteMapping.ps1
ExecStart=/usr/bin/pwsh -NoProfile -File ${CEC_HOME}/tools/Build-DriverLibrary.ps1 -OutputDir ${CEC_LIBRARY}
